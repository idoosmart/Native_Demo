<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ECEFF1"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_conn_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#C8E6C9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_support_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#FFE0B2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_full_set"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_send"
        android:gravity="center"
        android:text="@string/task_list_full_set"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_query_status"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_send"
        android:gravity="center"
        android:text="@string/task_list_query_status"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#BDBDBD" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="@string/task_list_query_json_title"
        android:textColor="#616161"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/sv_query_json"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_query_json"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/task_list_query_json_hint"
            android:textColor="@color/black"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
