<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gesture_control_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gesture_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/gesture_control_status_idle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_gesture_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/gesture_control_flow_hint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_gesture_master"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/gesture_control_master_switch"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/gesture_control_tree_title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_gesture_tree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/gesture_control_help"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btn_gesture_support"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gesture_control_btn_support"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_gesture_get"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gesture_control_btn_get"
                android:textColor="@color/white" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_gesture_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gesture_control_btn_set"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_gesture_call_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gesture_control_btn_call_notice"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_gesture_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gesture_control_btn_refresh"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_gesture_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gesture_control_btn_clear"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/gesture_control_last_json"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gesture_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/gesture_control_empty"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
